{
	"name": "dartmouth-hugh-backend",
	"version": "0.1.0",
	"private": true,
	"main": "src/app.ts",
	"scripts": {
		"dev": "bun --watch src/app.ts",
		"start": "bun src/app.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"prisma": "bunx prisma",
		"db:migrate": "bunx prisma migrate dev",
		"db:deploy": "bunx prisma migrate deploy",
		"db:generate": "bunx prisma generate"
	},
	"dependencies": {
		"@prisma/client": "^6.18.1",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"google-auth-library": "^10.4.0",
		"helmet": "^8.1.0",
		"node-cron": "^4.2.1",
		"nodemailer": "^7.0.9",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/bun": "^1.3.4",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.4",
		"@types/nodemailer": "^7.0.3",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.4.2",
		"prisma": "^6.18.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.18.2"
	}
}
