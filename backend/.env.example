# Local backend execution against the docker-compose database uses localhost.
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql://postgres:replace-with-postgres-password@localhost:5432/dartmouth_hugh
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
GMAIL_USER=you@dartmouth.edu
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SEND_CRON=0 7 * * *
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# Optional Sentry backend error logging
# SENTRY_DSN=

# Docker/Portainer notes:
# - Set GOOGLE_CLIENT_ID, GMAIL_USER, GMAIL_APP_PASSWORD, and FRONTEND_ORIGIN as
#   Portainer stack variables. Also set POSTGRES_PASSWORD for the database.
#   Optionally set EMAIL_SEND_CRON, SENTRY_DSN, and BACKEND_PORT.
# - Inside Docker, the backend service uses the compose database host:
#   db. The container derives DATABASE_URL from the database env vars.
